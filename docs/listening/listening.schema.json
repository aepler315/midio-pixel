{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Midio listening annotation 0.1",
  "description": "Proposed structural contract. Drafts may contain blanks. Audio binding, ordered non-overlapping intervals, and benchmark readiness require semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "status", "audio_file", "listener", "perspective", "basis", "summary", "segments", "trends", "events"],
  "properties": {
    "format": {"const": "midio-listening/0.1"},
    "status": {"enum": ["draft", "reviewed", "illustrative"]},
    "audio_file": {"type": ["string", "null"]},
    "listener": {"type": ["string", "null"]},
    "perspective": {"enum": ["expressed", "felt"]},
    "basis": {"enum": ["sound", "lyrics", "sound+lyrics", "unspecified"]},
    "summary": {"type": "string"},
    "segments": {
      "type": "array",
      "items": {"$ref": "#/$defs/segment"}
    },
    "trends": {
      "type": "array",
      "items": {"$ref": "#/$defs/trend"}
    },
    "events": {
      "type": "array",
      "items": {"$ref": "#/$defs/event"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "reviewed"}}, "required": ["status"]},
      "then": {
        "properties": {
          "audio_file": {"type": "string", "minLength": 1},
          "listener": {"type": "string", "minLength": 1},
          "summary": {"minLength": 1},
          "segments": {
            "minItems": 1,
            "items": {"properties": {"span": {"$ref": "#/$defs/concretePair"}}}
          },
          "trends": {"items": {"properties": {"span": {"$ref": "#/$defs/concretePair"}}}},
          "events": {"items": {"properties": {"within": {"$ref": "#/$defs/concretePair"}}}}
        }
      }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{2,}:[0-5][0-9](?:\\.[0-9]{1,3})?$"
    },
    "maybeTimestamp": {
      "anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]
    },
    "timePair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/maybeTimestamp"}
    },
    "concretePair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/timestamp"}
    },
    "rating": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
    "confidence": {"enum": ["high", "medium", "low", "unrated"]},
    "emotionName": {
      "enum": ["joy", "melancholy", "sadness", "longing", "nostalgia", "tenderness", "calm", "unease", "aggression", "triumph", "wonder", "playfulness"]
    },
    "emotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intensity", "role"],
      "properties": {
        "intensity": {"$ref": "#/$defs/rating"},
        "role": {"enum": ["foreground", "undertone", "absent", "unclear"]},
        "confidence": {"$ref": "#/$defs/confidence"},
        "notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"intensity": {"const": 0}}, "required": ["intensity"]},
          "then": {"properties": {"role": {"const": "absent"}}}
        },
        {
          "if": {"properties": {"role": {"const": "absent"}}, "required": ["role"]},
          "then": {"properties": {"intensity": {"const": 0}}}
        }
      ]
    },
    "sound": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brightness": {"$ref": "#/$defs/rating"},
        "activity": {"$ref": "#/$defs/rating"},
        "loudness": {"$ref": "#/$defs/rating"},
        "density": {"$ref": "#/$defs/rating"},
        "roughness": {"$ref": "#/$defs/rating"},
        "pulse": {"enum": ["steady", "free", "unclear", null]},
        "groove": {"enum": ["straight", "swung", "syncopated", "mixed", "unclear", null]}
      }
    },
    "affect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "valence": {"type": ["integer", "null"], "minimum": -2, "maximum": 2},
        "arousal": {"$ref": "#/$defs/rating"},
        "tension": {"$ref": "#/$defs/rating"}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span", "confidence"],
      "properties": {
        "span": {"$ref": "#/$defs/timePair"},
        "label": {"type": "string"},
        "sound": {"$ref": "#/$defs/sound"},
        "emotions": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/emotionName"},
          "additionalProperties": {"$ref": "#/$defs/emotion"}
        },
        "affect": {"$ref": "#/$defs/affect"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "notes": {"type": "string"}
      }
    },
    "trend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span", "target", "direction", "confidence"],
      "properties": {
        "span": {"$ref": "#/$defs/timePair"},
        "target": {
          "type": "string",
          "pattern": "^(emotions\\.(joy|melancholy|sadness|longing|nostalgia|tenderness|calm|unease|aggression|triumph|wonder|playfulness)\\.intensity|sound\\.(brightness|activity|loudness|density|roughness)|affect\\.(valence|arousal|tension))$"
        },
        "direction": {"enum": ["rising", "falling", "stable"]},
        "confidence": {"$ref": "#/$defs/confidence"},
        "notes": {"type": "string"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["within", "type", "from", "to", "confidence"],
      "properties": {
        "within": {"$ref": "#/$defs/timePair"},
        "type": {"const": "foreground_change"},
        "from": {"$ref": "#/$defs/emotionName"},
        "to": {"$ref": "#/$defs/emotionName"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "notes": {"type": "string"}
      }
    }
  }
}
