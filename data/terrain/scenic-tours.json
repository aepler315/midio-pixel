{
  "about": "Regional configuration for scenic shot tours (docs/scenic-tours.md). Geography, named-subject preferences, route anchors and region-dependent parameters live here; DEM sources stay in scenic-views.json. A region's status is its tour's own review state: a view plays its tour in production only when the view and its tour are both approved. Subject lonLat values marked approximate are snapped to the nearest matching DEM feature within snapRadiusM. These are current runtime selection semantics, not prerequisites for authoring or experimenting with a tour; see docs/experimental-development.md.",
  "version": 1,
  "defaults": {
    "lensFovYDeg": {
      "wide": 36,
      "normal": 26,
      "tele": 16
    },
    "clearance": {
      "minAglM": 70,
      "treeHeightM": 35,
      "subjectStandoffM": 300,
      "boundaryMarginM": 1500,
      "cellM": 60
    },
    "motion": {
      "maxSpeedMps": 120,
      "minSpeedMps": 4,
      "flowCalm": 0.07,
      "flowEnergetic": 0.24,
      "maxYawDegPerSec": 20,
      "maxClimbMps": 22,
      "maxAccelMps2": 3.5
    },
    "discovery": {
      "focusRadiusM": 11000,
      "maxSubjects": 12,
      "minSubjectSpacingM": 1800,
      "prominenceMinM": 80,
      "snapRadiusM": 2500,
      "shotsPerSubject": 8,
      "maxShots": 36,
      "maxLinksPerShot": 4,
      "tileWeight": 0.6,
      "byteScaleKB": 250,
      "linkMaxM": 6000,
      "transitMaxM": 9000,
      "maxShotS": 16,
      "maxLinkS": 50,
      "shotsPerRound": 6,
      "earShots": 5,
      "linkFanout": 14,
      "linkRadiusM": 400,
      "edgeDipDeg": 12,
      "frame": {
        "horizonBelowTop": 0.2,
        "subjectAboveBottom": 0.1
      },
      "horizonNote": "Rays that leave the DEM grid within edgeDipDeg below the horizontal are drawn as sky by the app, so the grid's far boundary reads as the horizon; measured in the app up to the deepest band any published camera saw (11.4 deg, Izta) with no visible crop. Before this rule, generators tilted every such view down until no ray left the grid, and high eyes aimed at a subject's mid-height looked 20-35 deg down: 47 of 126 round-2 shots framed no horizon. frame keeps the horizon at least 20% below the top edge while the subject's aim point stays at least 10% above the bottom (docs/scenic-tours.md, Horizon and the grid edge)."
    },
    "budget": {
      "assetBytes": 800000,
      "poseErrorScale": 4,
      "desktopTriangles": 3200000,
      "mobileTriangles": 1800000,
      "trianglesNote": "About 18 mesh bytes per triangle plus ~27 MB of surface textures per view; two views are resident across a seam, with forest and sky, inside the low-memory residency budgets (256 MiB desktop, 192 MiB mobile, src/render/GraphicsResidency.js)."
    }
  },
