# Optional Soulseek account for the bundled slskd (docker compose)
SLSK_USER=
SLSK_PASS=

# Optional bridge token. Required when starting the server with HOST=0.0.0.0.
# MIDIO_BRIDGE_TOKEN=generate-a-long-random-value

# Optional slskd overrides. The bundled loopback config does not ship a key.
# SLSKD_URL=http://127.0.0.1:5030
# SLSKD_API_KEY=
# SLSKD_DOWNLOADS=./data/slskd-downloads
