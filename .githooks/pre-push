#!/bin/sh
# Local gate before a normal Git push, in addition to PR verification.
# Installed by `npm install` / `npm ci` through the
# `prepare` script (tools/install-hooks.mjs). Bypass once with
# `git push --no-verify` when you know why.
#
# Git exports GIT_DIR and friends to hooks (githooks(5)); in a linked
# worktree GIT_DIR is absolute, and tests that build throwaway repositories
# would then commit into this one. Clear them before running anything.
unset $(git rev-parse --local-env-vars)
echo "pre-push: npm run lint && npm test && npm run check:modules -- --tracked (the full gate is npm run validate)"
# --tracked: a module that exists here but was never `git add`ed is not
# published, so the pushed site would fail to load it.
npm run lint && npm test && npm run check:modules -- --tracked
