# Copy privately to .env.plex. Never publish a PMS token.
MIDIO_PLEX_ENABLED=false
PLEX_BASE_URL=http://127.0.0.1:32400
PLEX_TOKEN=
PLEX_MUSIC_SECTION_IDS=
PLEX_CLIENT_IDENTIFIER=
PLEX_HOST=127.0.0.1
PLEX_PORT=8787
PLEX_ALLOWED_ORIGINS=https://supermaudio.com,http://127.0.0.1:8080
# Hostnames the adapter answers to besides loopback and IP literals (DNS-rebinding
# guard), e.g. the host of MIDIO_PLEX_PUBLIC_API_BASE behind a reverse proxy.
PLEX_PUBLIC_HOST=
