{
  "name": "midio-pixel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Music-reactive pixel landscapes with smooth skies and automatic performance.",
  "scripts": {
    "start": "node tools/serve.js",
    "dev": "node tools/serve.js 8080",
    "archive": "node tools/archive-serve.mjs --open",
    "lint": "eslint src tools test ridgeview",
    "test": "node --test --test-concurrency=1 test/*.js test/*.mjs",
    "test:all": "node --test",
    "check:modules": "node --experimental-vm-modules --no-warnings tools/module-graph-check.mjs",
    "validate": "node tools/validate.mjs",
    "prepare": "node tools/install-hooks.mjs",
    "test:smoke": "node tools/smoke.mjs",
    "test:bootstrap": "node tools/bootstrap-smoke.mjs",
    "test:routes": "node tools/current-routes-smoke.mjs",
    "test:gpu": "node tools/gpu-review.mjs",
    "stage:site": "node tools/stage-site.mjs . _site",
    "publish:site": "node tools/publish-site.mjs",
    "test:seek": "node tools/seek-effects-smoke.mjs",
    "test:shading": "node tools/static-shading-smoke.mjs",
    "test:landscape": "node tools/range-landscape-smoke.mjs",
    "test:peaks": "node tools/peak-evidence.mjs",
    "export:bulk": "node tools/bulk-export.mjs",
    "build:export-runtime": "node tools/build-export-runtime.mjs",
    "test:mp4export": "node tools/mp4-export-smoke.mjs",
    "test:car": "node tools/car-mode-smoke.mjs",
    "test:urlload": "node tools/url-load-smoke.mjs",
    "test:snapshot": "node tools/detail-snapshot-smoke.mjs",
    "music-server": "node tools/music-server.mjs",
    "bench:sections": "node tools/benchmark-segmentation.mjs",
    "build:compiled-terrain": "node --max-old-space-size=8192 tools/build-compiled-terrain.mjs",
    "eval:worlds": "node tools/evaluate-worlds.mjs",
    "slskd": "docker compose up -d slskd",
    "slskd:down": "docker compose down",
    "slskd:logs": "docker compose logs -f slskd",
    "start:full": "docker compose up -d slskd && node tools/serve.js",
    "stage:versions": "node tools/stage-history.mjs . _site",
    "visual:eval": "node tools/visual-evaluate.mjs",
    "review:landscape": "node tools/landscape-review.mjs",
    "scout:views": "node tools/build-view-discovery.mjs",
    "plex:server": "node --env-file=.env.plex tools/plex-server.mjs",
    "plex:probe": "node --env-file=.env.plex tools/plex-probe.mjs",
    "plex:config": "node tools/write-plex-public-config.mjs",
    "test:plex": "node tools/plex-smoke.mjs",
    "test:library-integrity": "node tools/library-scan-integrity-smoke.mjs",
    "test:tour-coverage": "node tools/tour-coverage-check.mjs",
    "test:rise-coverage": "node tools/rise-coverage-check.mjs",
    "verify:visual:capture": "node tools/verification/capture.mjs",
    "verify:visual": "node tools/verification/compare.mjs",
    "verify:visual:approve": "node tools/verification/approve.mjs",
    "bench:engineering": "node tools/verification/benchmark.mjs",
    "agent:handoff": "node tools/verification/handoff.mjs create",
    "agent:resume": "node tools/verification/handoff.mjs resume",
    "eval:agents": "node tools/verification/evaluate.mjs"
  },
  "dependencies": {
    "slsk-client": "2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "mediabunny": "1.66.0",
    "playwright": "^1.65.0",
    "pngjs": "7.0.0",
    "three": "0.187.0"
  },
  "engines": {
    "node": "24.x"
  }
}
